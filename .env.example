# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for deep channel syncing (hundreds of videos).
# Leave empty to use built-in Zero-Key public metadata & RSS sync.
YOUTUBE_API_KEY=""

# CRON_SECRET: Shared secret token sent by Google Cloud Scheduler in Authorization: Bearer <CRON_SECRET>
# or X-Cron-Secret header to trigger POST /api/cron/sync-youtube securely.
CRON_SECRET=""

# WEBSUB_SECRET: Optional HMAC-SHA1 secret registered with Google PubSubHubbub Hub
# to verify X-Hub-Signature on real-time YouTube push webhooks (/api/webhooks/youtube).
WEBSUB_SECRET=""

# PUBLIC_APP_URL: Optional canonical HTTPS domain (e.g. https://meetboston.duyvo.win or https://langthangbostone.com).
# Used for canonical SEO URLs, /sitemap.xml, /robots.txt, and YouTube WebSub callbacks.
# Leave empty to auto-detect dynamically from incoming Host / X-Forwarded-Host headers.
PUBLIC_APP_URL=""

