rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'duyweb5@gmail.com';
    }

    function emailToAdminId(email) {
      return email.lower().replace('[^a-z0-9]', '_');
    }

    function isListedAdminByUid() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isListedAdminByEmail() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/admins/$(emailToAdminId(request.auth.token.email))) &&
        get(/databases/$(database)/documents/admins/$(emailToAdminId(request.auth.token.email))).data.email == request.auth.token.email.lower();
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isListedAdminByUid() || isListedAdminByEmail();
    }

    function isFullAdmin() {
      return isBootstrappedAdmin() ||
        (isListedAdminByUid() &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin') ||
        (isListedAdminByEmail() &&
          get(/databases/$(database)/documents/admins/$(emailToAdminId(request.auth.token.email))).data.role == 'admin');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidEmail(val) {
      return isStr(val, 5, 160) && val.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidStatItem(item) {
      return item is map &&
        item.keys().hasAll(['value', 'labelVi', 'labelEn']) &&
        item.keys().hasOnly(['value', 'labelVi', 'labelEn']) &&
        isStr(item.value, 1, 24) &&
        isStr(item.labelVi, 1, 120) &&
        isStr(item.labelEn, 1, 120);
    }

    function isValidTopPick(item) {
      return item is map &&
        item.keys().hasAll(['name', 'categoryVi', 'categoryEn', 'noteVi', 'noteEn']) &&
        item.keys().hasOnly(['name', 'categoryVi', 'categoryEn', 'noteVi', 'noteEn']) &&
        isStr(item.name, 1, 120) &&
        isStr(item.categoryVi, 1, 60) &&
        isStr(item.categoryEn, 1, 60) &&
        isStr(item.noteVi, 1, 260) &&
        isStr(item.noteEn, 1, 260);
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap + Full Bounds)
    // -------------------------------------------------------------------------
    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'kickerVi', 'kickerEn', 'headlineVi', 'headlineEn',
          'subheadVi', 'subheadEn', 'heroImage',
          'visitorCenterAddress', 'visitorCenterHours',
          'footerAboutVi', 'footerAboutEn',
          'showExplore', 'showNeighborhoods', 'showEvents', 'showStay', 'showMeetings',
          'stats', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'kickerVi', 'kickerEn', 'headlineVi', 'headlineEn',
          'subheadVi', 'subheadEn', 'heroImage',
          'visitorCenterAddress', 'visitorCenterHours',
          'footerAboutVi', 'footerAboutEn',
          'showExplore', 'showNeighborhoods', 'showEvents', 'showStay', 'showMeetings',
          'stats', 'updatedBy', 'updatedAt'
        ]) &&
        isStr(data.kickerVi, 2, 160) &&
        isStr(data.kickerEn, 2, 160) &&
        isStr(data.headlineVi, 2, 180) &&
        isStr(data.headlineEn, 2, 180) &&
        isStr(data.subheadVi, 2, 500) &&
        isStr(data.subheadEn, 2, 500) &&
        isStr(data.heroImage, 1, 350000) &&
        isStr(data.visitorCenterAddress, 2, 220) &&
        isStr(data.visitorCenterHours, 2, 120) &&
        isStr(data.footerAboutVi, 2, 450) &&
        isStr(data.footerAboutEn, 2, 450) &&
        data.showExplore is bool &&
        data.showNeighborhoods is bool &&
        data.showEvents is bool &&
        data.showStay is bool &&
        data.showMeetings is bool &&
        data.stats is list &&
        data.stats.size() >= 1 &&
        data.stats.size() <= 4 &&
        isValidStatItem(data.stats[0]) &&
        (data.stats.size() < 2 || isValidStatItem(data.stats[1])) &&
        (data.stats.size() < 3 || isValidStatItem(data.stats[2])) &&
        (data.stats.size() < 4 || isValidStatItem(data.stats[3])) &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidExperience(data) {
      return data.keys().hasAll([
          'category', 'featured', 'published', 'sortOrder',
          'titleVi', 'titleEn', 'summaryVi', 'summaryEn',
          'descriptionVi', 'descriptionEn', 'insiderTipVi', 'insiderTipEn',
          'district', 'durationVi', 'durationEn', 'hours',
          'priceVi', 'priceEn', 'address', 'transit', 'image',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'category', 'featured', 'published', 'sortOrder',
          'titleVi', 'titleEn', 'summaryVi', 'summaryEn',
          'descriptionVi', 'descriptionEn', 'insiderTipVi', 'insiderTipEn',
          'district', 'durationVi', 'durationEn', 'hours',
          'priceVi', 'priceEn', 'address', 'transit', 'image',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.category in ['history', 'dining', 'arts', 'outdoors'] &&
        data.featured is bool &&
        data.published is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        isStr(data.titleVi, 2, 180) &&
        isStr(data.titleEn, 2, 180) &&
        isStr(data.summaryVi, 2, 420) &&
        isStr(data.summaryEn, 2, 420) &&
        isStr(data.descriptionVi, 2, 2000) &&
        isStr(data.descriptionEn, 2, 2000) &&
        isStr(data.insiderTipVi, 0, 500) &&
        isStr(data.insiderTipEn, 0, 500) &&
        isStr(data.district, 2, 100) &&
        isStr(data.durationVi, 1, 80) &&
        isStr(data.durationEn, 1, 80) &&
        isStr(data.hours, 1, 120) &&
        isStr(data.priceVi, 1, 120) &&
        isStr(data.priceEn, 1, 120) &&
        isStr(data.address, 2, 220) &&
        isStr(data.transit, 2, 160) &&
        isStr(data.image, 1, 350000) &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNeighborhood(data) {
      return data.keys().hasAll([
          'name', 'published', 'sortOrder',
          'taglineVi', 'taglineEn', 'descriptionVi', 'descriptionEn',
          'transit', 'vibeVi', 'vibeEn', 'walkScore', 'image', 'topPicks',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'published', 'sortOrder',
          'taglineVi', 'taglineEn', 'descriptionVi', 'descriptionEn',
          'transit', 'vibeVi', 'vibeEn', 'walkScore', 'image', 'topPicks',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.name, 2, 100) &&
        data.published is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        isStr(data.taglineVi, 2, 240) &&
        isStr(data.taglineEn, 2, 240) &&
        isStr(data.descriptionVi, 2, 1500) &&
        isStr(data.descriptionEn, 2, 1500) &&
        isStr(data.transit, 2, 160) &&
        isStr(data.vibeVi, 2, 120) &&
        isStr(data.vibeEn, 2, 120) &&
        data.walkScore is number && data.walkScore >= 0 && data.walkScore <= 100 &&
        isStr(data.image, 1, 350000) &&
        data.topPicks is list &&
        data.topPicks.size() >= 1 &&
        data.topPicks.size() <= 5 &&
        isValidTopPick(data.topPicks[0]) &&
        (data.topPicks.size() < 2 || isValidTopPick(data.topPicks[1])) &&
        (data.topPicks.size() < 3 || isValidTopPick(data.topPicks[2])) &&
        (data.topPicks.size() < 4 || isValidTopPick(data.topPicks[3])) &&
        (data.topPicks.size() < 5 || isValidTopPick(data.topPicks[4])) &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'dayNum', 'monthLabelVi', 'monthLabelEn', 'fullDateVi', 'fullDateEn',
          'timeframe', 'category', 'published', 'sortOrder',
          'titleVi', 'titleEn', 'venue', 'district', 'time',
          'priceVi', 'priceEn', 'descriptionVi', 'descriptionEn', 'image',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'dayNum', 'monthLabelVi', 'monthLabelEn', 'fullDateVi', 'fullDateEn',
          'timeframe', 'category', 'published', 'sortOrder',
          'titleVi', 'titleEn', 'venue', 'district', 'time',
          'priceVi', 'priceEn', 'descriptionVi', 'descriptionEn', 'image',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.dayNum, 1, 4) &&
        isStr(data.monthLabelVi, 2, 20) &&
        isStr(data.monthLabelEn, 2, 20) &&
        isStr(data.fullDateVi, 2, 80) &&
        isStr(data.fullDateEn, 2, 80) &&
        data.timeframe in ['week', 'month', 'holiday'] &&
        data.category in ['arts', 'sports', 'festival', 'exhibition'] &&
        data.published is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        isStr(data.titleVi, 2, 180) &&
        isStr(data.titleEn, 2, 180) &&
        isStr(data.venue, 2, 180) &&
        isStr(data.district, 2, 100) &&
        isStr(data.time, 2, 60) &&
        isStr(data.priceVi, 1, 100) &&
        isStr(data.priceEn, 1, 100) &&
        isStr(data.descriptionVi, 2, 1500) &&
        isStr(data.descriptionEn, 2, 1500) &&
        isStr(data.image, 1, 350000) &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHotel(data) {
      return data.keys().hasAll([
          'name', 'district', 'neighborhoodKey', 'published', 'sortOrder',
          'styleVi', 'styleEn', 'rateUsd', 'rating',
          'summaryVi', 'summaryEn', 'descriptionVi', 'descriptionEn',
          'address', 'amenitiesVi', 'amenitiesEn', 'image',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'district', 'neighborhoodKey', 'published', 'sortOrder',
          'styleVi', 'styleEn', 'rateUsd', 'rating',
          'summaryVi', 'summaryEn', 'descriptionVi', 'descriptionEn',
          'address', 'amenitiesVi', 'amenitiesEn', 'image',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.name, 2, 140) &&
        isStr(data.district, 2, 100) &&
        data.neighborhoodKey in ['back-bay', 'seaport', 'beacon-hill'] &&
        data.published is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        isStr(data.styleVi, 2, 100) &&
        isStr(data.styleEn, 2, 100) &&
        data.rateUsd is number && data.rateUsd >= 10 && data.rateUsd <= 25000 &&
        isStr(data.rating, 1, 10) &&
        isStr(data.summaryVi, 2, 420) &&
        isStr(data.summaryEn, 2, 420) &&
        isStr(data.descriptionVi, 2, 1500) &&
        isStr(data.descriptionEn, 2, 1500) &&
        isStr(data.address, 2, 220) &&
        data.amenitiesVi is list && data.amenitiesVi.size() >= 1 && data.amenitiesVi.size() <= 10 &&
        isStr(data.amenitiesVi[0], 1, 100) &&
        data.amenitiesEn is list && data.amenitiesEn.size() >= 1 && data.amenitiesEn.size() <= 10 &&
        isStr(data.amenitiesEn[0], 1, 100) &&
        isStr(data.image, 1, 350000) &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGuideLead(data) {
      return data.keys().hasAll(['email', 'source', 'lang', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['email', 'source', 'lang', 'status', 'createdAt', 'updatedAt']) &&
        isValidEmail(data.email) &&
        data.source in ['visitor_guide', 'newsletter'] &&
        data.lang in ['vi', 'en'] &&
        data.status in ['new', 'contacted', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMeetingRfp(data) {
      return data.keys().hasAll([
          'organization', 'email', 'guests', 'timeframe', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organization', 'email', 'guests', 'timeframe', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.organization, 2, 180) &&
        isValidEmail(data.email) &&
        isStr(data.guests, 2, 40) &&
        isStr(data.timeframe, 2, 40) &&
        isStr(data.notes, 0, 1200) &&
        data.status in ['new', 'reviewing', 'responded', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['email', 'displayName', 'role', 'addedBy', 'createdAt']) &&
        isValidEmail(data.email) &&
        isStr(data.displayName, 1, 120) &&
        data.role in ['admin', 'editor'] &&
        isStr(data.addedBy, 1, 128) &&
        data.createdAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll([
          'seoFileName', 'altVi', 'altEn', 'url', 'storagePath', 'storageProvider',
          'mimeType', 'width', 'height', 'originalBytes', 'optimizedBytes',
          'source', 'folder', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'seoFileName', 'altVi', 'altEn', 'url', 'storagePath', 'storageProvider',
          'mimeType', 'width', 'height', 'originalBytes', 'optimizedBytes',
          'source', 'folder', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.seoFileName, 3, 180) &&
        data.seoFileName.matches('^[a-z0-9\\-]+\\.(webp|jpg|jpeg|png)$') &&
        isStr(data.altVi, 1, 240) &&
        isStr(data.altEn, 1, 240) &&
        isStr(data.url, 1, 350000) &&
        isStr(data.storagePath, 0, 300) &&
        data.storageProvider in ['firebase_storage', 'firestore_compact'] &&
        data.mimeType in ['image/webp', 'image/jpeg', 'image/png'] &&
        data.width is number && data.width >= 1 && data.width <= 8000 &&
        data.height is number && data.height >= 1 && data.height <= 8000 &&
        data.originalBytes is number && data.originalBytes >= 1 && data.originalBytes <= 50000000 &&
        data.optimizedBytes is number && data.optimizedBytes >= 1 && data.optimizedBytes <= 1000000 &&
        data.source in ['computer', 'google_drive'] &&
        data.folder in ['hero', 'experiences', 'neighborhoods', 'events', 'hotels', 'general'] &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidI18nConfig(data) {
      return data.keys().hasAll([
          'defaultLanguage', 'enableVi', 'enableEn',
          'showLanguageSwitcher', 'autoDetectBrowser',
          'viLabel', 'enLabel', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'defaultLanguage', 'enableVi', 'enableEn',
          'showLanguageSwitcher', 'autoDetectBrowser',
          'viLabel', 'enLabel', 'updatedBy', 'updatedAt'
        ]) &&
        data.defaultLanguage in ['vi', 'en'] &&
        data.enableVi is bool &&
        data.enableEn is bool &&
        (data.enableVi == true || data.enableEn == true) &&
        ((data.defaultLanguage == 'vi' && data.enableVi == true) ||
          (data.defaultLanguage == 'en' && data.enableEn == true)) &&
        data.showLanguageSwitcher is bool &&
        data.autoDetectBrowser is bool &&
        isStr(data.viLabel, 1, 40) &&
        isStr(data.enLabel, 1, 40) &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidUiTranslation(data) {
      return data.keys().hasAll([
          'group', 'keyPath', 'valueVi', 'valueEn', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'group', 'keyPath', 'valueVi', 'valueEn', 'updatedBy', 'updatedAt'
        ]) &&
        data.group in [
          'nav', 'hero', 'explore', 'neighborhoods', 'events',
          'stay', 'videos', 'drawer', 'modal', 'meetingsModal', 'footer'
        ] &&
        isStr(data.keyPath, 2, 120) &&
        isStr(data.valueVi, 1, 600) &&
        isStr(data.valueEn, 1, 600) &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidVideoChannel(data) {
      return data.keys().hasAll([
          'youtubeChannelId', 'handle', 'url', 'titleVi', 'titleEn',
          'descriptionVi', 'descriptionEn', 'avatarUrl',
          'ctaEnabled', 'ctaTitleVi', 'ctaTitleEn', 'ctaSubtitleVi', 'ctaSubtitleEn',
          'ctaButtonLabelVi', 'ctaButtonLabelEn', 'ctaButtonUrl',
          'published', 'videoCount', 'lastSyncedAt',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'youtubeChannelId', 'handle', 'url', 'titleVi', 'titleEn',
          'descriptionVi', 'descriptionEn', 'avatarUrl',
          'ctaEnabled', 'ctaTitleVi', 'ctaTitleEn', 'ctaSubtitleVi', 'ctaSubtitleEn',
          'ctaButtonLabelVi', 'ctaButtonLabelEn', 'ctaButtonUrl',
          'published', 'videoCount', 'lastSyncedAt',
          'autoSyncEnabled', 'webSubEnabled', 'autoAiOptimize', 'autoPublishNew',
          'webSubStatus', 'webSubSubscribedAt', 'webSubLeaseExpiresAt',
          'lastAutoSyncStatus', 'lastAutoSyncSummary',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.youtubeChannelId, 2, 120) &&
        isStr(data.handle, 0, 100) &&
        isStr(data.url, 5, 300) &&
        isStr(data.titleVi, 1, 160) &&
        isStr(data.titleEn, 1, 160) &&
        isStr(data.descriptionVi, 0, 1200) &&
        isStr(data.descriptionEn, 0, 1200) &&
        isStr(data.avatarUrl, 0, 500) &&
        data.ctaEnabled is bool &&
        isStr(data.ctaTitleVi, 0, 180) &&
        isStr(data.ctaTitleEn, 0, 180) &&
        isStr(data.ctaSubtitleVi, 0, 360) &&
        isStr(data.ctaSubtitleEn, 0, 360) &&
        isStr(data.ctaButtonLabelVi, 0, 80) &&
        isStr(data.ctaButtonLabelEn, 0, 80) &&
        isStr(data.ctaButtonUrl, 0, 400) &&
        data.published is bool &&
        data.videoCount is number && data.videoCount >= 0 && data.videoCount <= 100000 &&
        isStr(data.lastSyncedAt, 0, 60) &&
        (!('autoSyncEnabled' in data) || data.autoSyncEnabled is bool) &&
        (!('webSubEnabled' in data) || data.webSubEnabled is bool) &&
        (!('autoAiOptimize' in data) || data.autoAiOptimize is bool) &&
        (!('autoPublishNew' in data) || data.autoPublishNew is bool) &&
        (!('webSubStatus' in data) || data.webSubStatus in ['inactive', 'pending', 'active', 'error']) &&
        (!('webSubSubscribedAt' in data) || isStr(data.webSubSubscribedAt, 0, 60)) &&
        (!('webSubLeaseExpiresAt' in data) || isStr(data.webSubLeaseExpiresAt, 0, 60)) &&
        (!('lastAutoSyncStatus' in data) || data.lastAutoSyncStatus in ['idle', 'success', 'partial', 'error']) &&
        (!('lastAutoSyncSummary' in data) || isStr(data.lastAutoSyncSummary, 0, 400)) &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVideoTopic(data) {
      return data.keys().hasAll([
          'channelId', 'youtubePlaylistId', 'titleVi', 'titleEn',
          'descriptionVi', 'descriptionEn', 'slug', 'sortOrder', 'published',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'channelId', 'youtubePlaylistId', 'titleVi', 'titleEn',
          'descriptionVi', 'descriptionEn', 'slug', 'sortOrder', 'published',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.channelId, 1, 128) &&
        isStr(data.youtubePlaylistId, 0, 120) &&
        isStr(data.titleVi, 1, 140) &&
        isStr(data.titleEn, 1, 140) &&
        isStr(data.descriptionVi, 0, 420) &&
        isStr(data.descriptionEn, 0, 420) &&
        isStr(data.slug, 1, 120) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.published is bool &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVideoItem(data) {
      return data.keys().hasAll([
          'channelId', 'topicId', 'youtubeId', 'channelName', 'thumbnail',
          'duration', 'durationSeconds', 'publishedDate', 'viewCount',
          'rawTitle', 'rawDescription', 'titleVi', 'titleEn',
          'summaryVi', 'summaryEn', 'descriptionVi', 'descriptionEn',
          'highlightsVi', 'highlightsEn', 'seoTitleVi', 'seoTitleEn',
          'seoDescriptionVi', 'seoDescriptionEn', 'slugVi', 'slugEn',
          'keywordsVi', 'keywordsEn', 'status', 'aiStatus',
          'manuallyEdited', 'featured', 'sortOrder',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'channelId', 'topicId', 'youtubeId', 'channelName', 'thumbnail',
          'duration', 'durationSeconds', 'publishedDate', 'viewCount',
          'rawTitle', 'rawDescription', 'titleVi', 'titleEn',
          'summaryVi', 'summaryEn', 'descriptionVi', 'descriptionEn',
          'highlightsVi', 'highlightsEn', 'seoTitleVi', 'seoTitleEn',
          'seoDescriptionVi', 'seoDescriptionEn', 'slugVi', 'slugEn',
          'keywordsVi', 'keywordsEn', 'status', 'aiStatus',
          'manuallyEdited', 'featured', 'sortOrder',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.channelId, 1, 128) &&
        isStr(data.topicId, 0, 128) &&
        isStr(data.youtubeId, 5, 32) &&
        isStr(data.channelName, 1, 160) &&
        isStr(data.thumbnail, 5, 500) &&
        isStr(data.duration, 0, 24) &&
        data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
        isStr(data.publishedDate, 0, 60) &&
        data.viewCount is number && data.viewCount >= 0 && data.viewCount <= 2000000000 &&
        isStr(data.rawTitle, 1, 240) &&
        isStr(data.rawDescription, 0, 5000) &&
        isStr(data.titleVi, 1, 200) &&
        isStr(data.titleEn, 1, 200) &&
        isStr(data.summaryVi, 0, 480) &&
        isStr(data.summaryEn, 0, 480) &&
        isStr(data.descriptionVi, 0, 3000) &&
        isStr(data.descriptionEn, 0, 3000) &&
        data.highlightsVi is list && data.highlightsVi.size() <= 5 &&
        (data.highlightsVi.size() == 0 || isStr(data.highlightsVi[0], 1, 260)) &&
        data.highlightsEn is list && data.highlightsEn.size() <= 5 &&
        (data.highlightsEn.size() == 0 || isStr(data.highlightsEn[0], 1, 260)) &&
        isStr(data.seoTitleVi, 0, 120) &&
        isStr(data.seoTitleEn, 0, 120) &&
        isStr(data.seoDescriptionVi, 0, 260) &&
        isStr(data.seoDescriptionEn, 0, 260) &&
        isStr(data.slugVi, 1, 120) &&
        isStr(data.slugEn, 1, 120) &&
        data.keywordsVi is list && data.keywordsVi.size() <= 10 &&
        (data.keywordsVi.size() == 0 || isStr(data.keywordsVi[0], 1, 80)) &&
        data.keywordsEn is list && data.keywordsEn.size() <= 10 &&
        (data.keywordsEn.size() == 0 || isStr(data.keywordsEn[0], 1, 80)) &&
        data.status in ['draft', 'published'] &&
        data.aiStatus in ['pending', 'optimized', 'manual'] &&
        data.manuallyEdited is bool &&
        data.featured is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 100000 &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVideoGlossaryTerm(data) {
      return data.keys().hasAll([
          'sourceTerm', 'targetVi', 'targetEn', 'keepOriginal', 'notes',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sourceTerm', 'targetVi', 'targetEn', 'keepOriginal', 'notes',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isStr(data.sourceTerm, 1, 120) &&
        isStr(data.targetVi, 1, 140) &&
        isStr(data.targetEn, 1, 140) &&
        data.keepOriginal is bool &&
        isStr(data.notes, 0, 300) &&
        isStr(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSharedTripItem(item) {
      return item is map &&
        item.keys().hasAll([
          'id', 'type', 'day', 'titleVi', 'titleEn',
          'subtitleVi', 'subtitleEn', 'district', 'image'
        ]) &&
        item.keys().hasOnly([
          'id', 'type', 'day', 'titleVi', 'titleEn',
          'subtitleVi', 'subtitleEn', 'district', 'image'
        ]) &&
        isStr(item.id, 1, 128) &&
        item.type in ['experience', 'neighborhood', 'event', 'hotel', 'video'] &&
        item.day in [1, 2, 3] &&
        isStr(item.titleVi, 1, 200) &&
        isStr(item.titleEn, 1, 200) &&
        isStr(item.subtitleVi, 0, 160) &&
        isStr(item.subtitleEn, 0, 160) &&
        isStr(item.district, 1, 120) &&
        isStr(item.image, 0, 1000);
    }

    function isValidSharedItinerary(data) {
      return data.keys().hasAll(['title', 'lang', 'items', 'createdAt']) &&
        data.keys().hasOnly(['title', 'lang', 'items', 'createdAt']) &&
        isStr(data.title, 2, 140) &&
        data.lang in ['vi', 'en'] &&
        data.items is list &&
        data.items.size() >= 1 &&
        data.items.size() <= 30 &&
        isValidSharedTripItem(data.items[0]) &&
        (data.items.size() < 2 || isValidSharedTripItem(data.items[1])) &&
        (data.items.size() < 3 || isValidSharedTripItem(data.items[2])) &&
        (data.items.size() < 4 || isValidSharedTripItem(data.items[3])) &&
        (data.items.size() < 5 || isValidSharedTripItem(data.items[4])) &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules (Auth -> Static Validation -> Relational Lookup)
    // -------------------------------------------------------------------------

    // 1. SiteConfig (Homepage Hero, Stats, Footer, Section Visibility)
    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(configId) && configId == 'main' &&
        isValidSiteConfig(incoming()) &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(configId) && configId == 'main' &&
        isValidSiteConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'kickerVi', 'kickerEn', 'headlineVi', 'headlineEn',
          'subheadVi', 'subheadEn', 'heroImage',
          'visitorCenterAddress', 'visitorCenterHours',
          'footerAboutVi', 'footerAboutEn',
          'showExplore', 'showNeighborhoods', 'showEvents', 'showStay', 'showMeetings',
          'stats', 'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    // 2. Experiences (Things to Do)
    match /experiences/{experienceId} {
      allow get: if isValidId(experienceId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(experienceId) &&
        isValidExperience(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(experienceId) &&
        isValidExperience(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'category', 'featured', 'published', 'sortOrder',
          'titleVi', 'titleEn', 'summaryVi', 'summaryEn',
          'descriptionVi', 'descriptionEn', 'insiderTipVi', 'insiderTipEn',
          'district', 'durationVi', 'durationEn', 'hours',
          'priceVi', 'priceEn', 'address', 'transit', 'image', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(experienceId) && isAdmin();
    }

    // 3. Neighborhoods
    match /neighborhoods/{neighborhoodId} {
      allow get: if isValidId(neighborhoodId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(neighborhoodId) &&
        isValidNeighborhood(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(neighborhoodId) &&
        isValidNeighborhood(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'published', 'sortOrder',
          'taglineVi', 'taglineEn', 'descriptionVi', 'descriptionEn',
          'transit', 'vibeVi', 'vibeEn', 'walkScore', 'image', 'topPicks', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(neighborhoodId) && isAdmin();
    }

    // 4. Events Calendar
    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(eventId) &&
        isValidEvent(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(eventId) &&
        isValidEvent(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'dayNum', 'monthLabelVi', 'monthLabelEn', 'fullDateVi', 'fullDateEn',
          'timeframe', 'category', 'published', 'sortOrder',
          'titleVi', 'titleEn', 'venue', 'district', 'time',
          'priceVi', 'priceEn', 'descriptionVi', 'descriptionEn', 'image', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(eventId) && isAdmin();
    }

    // 5. Hotels Directory
    match /hotels/{hotelId} {
      allow get: if isValidId(hotelId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(hotelId) &&
        isValidHotel(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(hotelId) &&
        isValidHotel(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'district', 'neighborhoodKey', 'published', 'sortOrder',
          'styleVi', 'styleEn', 'rateUsd', 'rating',
          'summaryVi', 'summaryEn', 'descriptionVi', 'descriptionEn',
          'address', 'amenitiesVi', 'amenitiesEn', 'image', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(hotelId) && isAdmin();
    }

    // 6. Guide Leads (PII isolated strictly to admins; public create only)
    match /guideLeads/{leadId} {
      allow get: if isVerifiedUser() && isValidId(leadId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(leadId) &&
        isValidGuideLead(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(leadId) &&
        isValidGuideLead(incoming()) &&
        incoming().email == existing().email &&
        incoming().source == existing().source &&
        incoming().lang == existing().lang &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(leadId) && isAdmin();
    }

    // 7. Meeting RFPs (PII isolated strictly to admins; public create only)
    match /meetingRfps/{rfpId} {
      allow get: if isVerifiedUser() && isValidId(rfpId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(rfpId) &&
        isValidMeetingRfp(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(rfpId) &&
        isValidMeetingRfp(incoming()) &&
        incoming().organization == existing().organization &&
        incoming().email == existing().email &&
        incoming().guests == existing().guests &&
        incoming().timeframe == existing().timeframe &&
        incoming().notes == existing().notes &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(rfpId) && isAdmin();
    }

    // 8. Admin Allowlist (RBAC)
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (
        request.auth.uid == userId ||
        (request.auth.token.email is string && emailToAdminId(request.auth.token.email) == userId) ||
        isAdmin()
      );
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() &&
        isValidId(userId) &&
        isValidAdminUser(incoming()) &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin() &&
        isValidId(userId) &&
        isValidAdminUser(incoming()) &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'email']);
      allow delete: if isBootstrappedAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    // 9. Media Library Assets (Admins & Editors upload/edit SEO; only Super Admin & Admin delete)
    match /mediaAssets/{assetId} {
      allow get: if isVerifiedUser() && isValidId(assetId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(assetId) &&
        isValidMediaAsset(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(assetId) &&
        isValidMediaAsset(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().url == existing().url &&
        incoming().storagePath == existing().storagePath &&
        incoming().storageProvider == existing().storageProvider &&
        incoming().mimeType == existing().mimeType &&
        incoming().width == existing().width &&
        incoming().height == existing().height &&
        incoming().originalBytes == existing().originalBytes &&
        incoming().optimizedBytes == existing().optimizedBytes &&
        incoming().source == existing().source &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'seoFileName', 'altVi', 'altEn', 'folder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(assetId) && isFullAdmin();
    }

    // 10. Global Bilingual Language Configuration (/i18nConfig/main)
    match /i18nConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(configId) && configId == 'main' &&
        isValidI18nConfig(incoming()) &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(configId) && configId == 'main' &&
        isValidI18nConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'defaultLanguage', 'enableVi', 'enableEn',
          'showLanguageSwitcher', 'autoDetectBrowser',
          'viLabel', 'enLabel', 'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    // 11. Public UI Translation Overrides (/uiTranslations/{entryId})
    match /uiTranslations/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.group in [
        'nav', 'hero', 'explore', 'neighborhoods', 'events',
        'stay', 'videos', 'drawer', 'modal', 'meetingsModal', 'footer'
      ] || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidUiTranslation(incoming()) &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidUiTranslation(incoming()) &&
        incoming().group == existing().group &&
        incoming().keyPath == existing().keyPath &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'valueVi', 'valueEn', 'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(entryId) && isAdmin();
    }

    // 12. YouTube Video Channels (/videoChannels/{channelId})
    match /videoChannels/{channelId} {
      allow get: if isValidId(channelId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(channelId) &&
        isValidVideoChannel(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(channelId) &&
        isValidVideoChannel(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'youtubeChannelId', 'handle', 'url', 'titleVi', 'titleEn',
          'descriptionVi', 'descriptionEn', 'avatarUrl',
          'ctaEnabled', 'ctaTitleVi', 'ctaTitleEn', 'ctaSubtitleVi', 'ctaSubtitleEn',
          'ctaButtonLabelVi', 'ctaButtonLabelEn', 'ctaButtonUrl',
          'published', 'videoCount', 'lastSyncedAt',
          'autoSyncEnabled', 'webSubEnabled', 'autoAiOptimize', 'autoPublishNew',
          'webSubStatus', 'webSubSubscribedAt', 'webSubLeaseExpiresAt',
          'lastAutoSyncStatus', 'lastAutoSyncSummary',
          'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(channelId) && isAdmin();
    }

    // 13. Video Topics / Playlists (/videoTopics/{topicId})
    match /videoTopics/{topicId} {
      allow get: if isValidId(topicId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(topicId) &&
        isValidVideoTopic(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(topicId) &&
        isValidVideoTopic(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'channelId', 'youtubePlaylistId', 'titleVi', 'titleEn',
          'descriptionVi', 'descriptionEn', 'slug', 'sortOrder', 'published', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(topicId) && isAdmin();
    }

    // 14. Video Library Items (/videos/{videoId})
    match /videos/{videoId} {
      allow get: if isValidId(videoId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(videoId) &&
        isValidVideoItem(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(videoId) &&
        isValidVideoItem(incoming()) &&
        incoming().youtubeId == existing().youtubeId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'channelId', 'topicId', 'channelName', 'thumbnail',
          'duration', 'durationSeconds', 'publishedDate', 'viewCount',
          'rawTitle', 'rawDescription', 'titleVi', 'titleEn',
          'summaryVi', 'summaryEn', 'descriptionVi', 'descriptionEn',
          'highlightsVi', 'highlightsEn', 'seoTitleVi', 'seoTitleEn',
          'seoDescriptionVi', 'seoDescriptionEn', 'slugVi', 'slugEn',
          'keywordsVi', 'keywordsEn', 'status', 'aiStatus',
          'manuallyEdited', 'featured', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(videoId) && isAdmin();
    }

    // 15. AI Video Glossary / Translation Memory (/videoGlossary/{termId}) - Admin only
    match /videoGlossary/{termId} {
      allow get: if isVerifiedUser() && isValidId(termId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(termId) &&
        isValidVideoGlossaryTerm(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(termId) &&
        isValidVideoGlossaryTerm(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'sourceTerm', 'targetVi', 'targetEn', 'keepOriginal', 'notes', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(termId) && isAdmin();
    }

    // 16. Automated Video Sync Audit Logs (/videoSyncLogs/{logId}) - Server-written only; Admin read/delete
    match /videoSyncLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if false;
      allow delete: if isVerifiedUser() && isValidId(logId) && isAdmin();
    }

    // 17. Shareable Public Trip Itineraries (/sharedItineraries/{shareId}) - Immutable snapshots
    match /sharedItineraries/{shareId} {
      allow get: if isValidId(shareId);
      allow list: if isAdmin();
      allow create: if isValidId(shareId) &&
        isValidSharedItinerary(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(shareId) && isAdmin();
    }

    // Connection test probe path for startup check
    match /test/connection {
      allow get: if true;
    }
  }
}
